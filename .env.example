# =============================================================================
# GitHub Actions Self-Hosted Runner — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in your values before deploying:
#   cp .env.example .env
#
# The .env file is consumed by:
#   - docker-compose.yml  (via variable interpolation)
#   - docker stack deploy  (pass with: --env-file .env or export vars first)
#
# IMPORTANT: Never commit .env to version control.
# The .gitignore in this repo excludes .env by default.
# =============================================================================

# ── Required ──────────────────────────────────────────────────────────────────

# Full GitHub URL for the repository or organisation to register runners against.
# Format:
#   Repository:    https://github.com/OWNER/REPO
#   Organisation:  https://github.com/OWNER
GITHUB_URL=https://github.com/YOUR_ORG_OR_USER/YOUR_REPO

# ── Token — choose one method (prefer Docker secrets for production) ──────────
#
# Option A — Raw registration token (DEVELOPMENT ONLY)
# Generate from: GitHub → Repo/Org Settings → Actions → Runners → New self-hosted runner
# WARNING: Expires after ~1 hour. Not suitable for persistent Swarm deployments.
# RUNNER_TOKEN=ABCDEFGHIJKLMNOP1234567890

# Option B — Long-lived Personal Access Token (RECOMMENDED for production)
# Required scopes:
#   • Repository-level:    repo  (or public_repo for public repos)
#   • Organisation-level:  admin:org
#
# Best practice: store as a Docker secret, NOT in this file.
# Create the secret with: echo "ghp_yourPAThere" | docker secret create github_pat -
#
# Only set here if Docker secrets are not available (e.g. local dev without Swarm):
# GITHUB_PAT=ghp_yourPAThere

# ── Runner configuration ──────────────────────────────────────────────────────

# Comma-separated labels assigned to this runner.
# Workflows target this runner with:  runs-on: [self-hosted, linux, x64]
RUNNER_LABELS=self-hosted,linux,x64

# Runner group name (must already exist in your GitHub org/repo settings).
# Default group is "Default" — available in all plans.
RUNNER_GROUP=Default

# Ephemeral mode (true/false).
# true (recommended): Runner deregisters and exits after processing one job.
#                     Swarm restart_policy brings up a fresh, clean runner.
#                     Prevents state leakage between jobs.
# false: Runner is persistent and picks up multiple jobs sequentially.
RUNNER_EPHEMERAL=true

# Workspace cleanup (true/false).
# true (default): Clean /home/runner/_work at container startup. Recommended
#                 for ephemeral runners to prevent cross-job data leakage.
# false: Retain the workspace across runner restarts. Useful for caching
#        tool downloads (pip, npm, etc.) between ephemeral runs on the same
#        Swarm node, but may leak state between jobs. Use with trusted workflows only.
WORKSPACE_CLEANUP=true

# Number of Swarm replicas (i.e., concurrent runners in the pool).
# You can also scale after deploy: docker service scale runner_github-runner=N
RUNNER_REPLICAS=1

# ── Image ─────────────────────────────────────────────────────────────────────

# Docker image to use for the github-runner service.
# Use the pre-built image from GitHub Container Registry (replace YOUR_USERNAME):
RUNNER_IMAGE=ghcr.io/YOUR_USERNAME/github-runner:latest
# Or pin to a specific version:
# RUNNER_IMAGE=ghcr.io/YOUR_USERNAME/github-runner:2.325.0
# Or build locally and use that:
# RUNNER_IMAGE=github-runner:latest

# ── Proxy settings (optional) ─────────────────────────────────────────────────
# Only configure these if your runners are behind a corporate proxy.
# These values are written to the runner's .env file at startup so the
# runner process uses them for all outbound connections.
#
# Supported formats:
#   http://proxy.example.com:8080
#   http://username:password@proxy.example.com:8080
#
# HTTPS_PROXY=http://proxy.example.com:8080
# HTTP_PROXY=http://proxy.example.com:8080
#
# Comma-separated list of hosts/domains that bypass the proxy.
# NOTE: GitHub docs warn that IP addresses in no_proxy are NOT supported
# on self-hosted runners. Use hostnames only.
# NO_PROXY=localhost,127.0.0.1,.internal.example.com
